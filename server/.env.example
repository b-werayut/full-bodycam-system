# Database
DATABASE_URL="sqlserver://localhost:1433;database=bodycam;user=sa;password=yourpassword;encrypt=true;trustServerCertificate=true"

# Server
PORT=3009
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# DSS API
LOGIN_API_URL=https://dss.example.com/api/login
STREAM_API_URL=https://dss.example.com/api/stream
PLAYBACK_API_URL=https://dss.example.com/api/playback
LOCATION_API_URL=https://dss.example.com/api/v1/location
RECORDING_SEARCH_API_URL=https://dss.example.com/api/v1/recording/search
USER_DSS=your-dss-username
PWD_DSS=your-dss-password

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
ACCESS_TOKEN_EXPIRES_IN=900
REFRESH_TOKEN_EXPIRES_IN=604800

# Password Hashing
PASSWORD_ITERATIONS=100000
PASSWORD_KEYLEN=64
PASSWORD_DIGEST=sha512

# Device status scheduler (seconds)
DEVICE_STATUS_CHECK_INTERVAL_SECONDS=60
DEVICE_STATUS_ALERT_DELAY_SECONDS=900
DEVICE_STATUS_CACHE_RESET_SECONDS=3600
DEVICE_STATUS_ONLINE_INACTIVE_REPEAT_SECONDS=3600

# Event log cleanup cronjob
EVENT_LOG_RETENTION_DAYS=90
EVENT_LOG_CLEANUP_CRON="0 0 * * *"
EVENT_LOG_CLEANUP_TIMEZONE=Asia/Bangkok

# Mission alert scheduler (seconds) — แจ้งเตือนเมื่อใบงานถึงเวลาเริ่มแต่ยังไม่กดรับงาน
MISSION_ALERT_CHECK_INTERVAL_SECONDS=60
MISSION_ALERT_OVERDUE_GRACE_SECONDS=0
MISSION_ALERT_REPEAT_SECONDS=3600

# Rate Limiting
RATE_LIMIT_MAX_REQUESTS=10000
RATE_LIMIT_WINDOW_MS=900000

# Video cache (milliseconds)
VIDEO_CACHE_DURATION_MS=604800000
VIDEO_MAX_CONVERSION_TIME_MS=7200000

# Firebase Cloud Messaging (push notification) — ทั้งคู่ optional มี default อยู่แล้ว
# FIREBASE_PUSH_ENABLED=true                                  # ตั้ง false เพื่อปิด push (เช่นตอน dev)
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase/service_account.json # path ของ service account (relative กับ server root)

# Device token cleanup cronjob — ปิด FCM token ที่ไม่ได้อัปเดต (LastSeenAt) นานเกินกำหนด
DEVICE_TOKEN_RETENTION_DAYS=60
DEVICE_TOKEN_CLEANUP_CRON="0 3 * * *"
DEVICE_TOKEN_CLEANUP_TIMEZONE=Asia/Bangkok
